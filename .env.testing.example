APP_NAME="Designacion de Docentes UATF"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
AUTH_PROVIDER=users

DB_CONNECTION=jachasun
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=designaciones_uatf_testing
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=null
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
FILESYSTEM_DISK=local
FILESYSTEM_ROOT=storage/app/testing/private
FILESYSTEM_PUBLIC_ROOT=storage/app/testing/public
EXTERNAL_SERVICES_MODE=fake

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
